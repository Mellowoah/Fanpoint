{
  "name": "fanpoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "eval": "node scripts/eval.mjs",
    "screens": "node scripts/screens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "ci": "npm run lint && npm run typecheck && npm run coverage && npm run build && npm run check:bundle",
    "baseline": "node scripts/baseline.mjs",
    "compare-baselines": "node scripts/compare-baselines.mjs",
    "verify:llm": "node scripts/verify-llm-live.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}
