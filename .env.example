# Copy to .env.local and fill in. Never commit real keys.
# Leave a key empty to run that provider on clearly-labeled mock fixtures.

# Qloo hackathon API key (from the Qloo hackathon key request form). Sent as X-Api-Key.
QLOO_API_KEY=
# Hackathon keys only work against this host (Qloo hackathon developer guide). Do not change unless Qloo tells you to.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# The key is only sent to https://hackathon.api.qloo.com or https://api.qloo.com. To use any other base URL
# (a proxy or a local mock), also set it here, exactly. Otherwise Fanpoint refuses to send the key.
QLOO_TRUSTED_BASE_URL=

# Any OpenAI-compatible Chat Completions endpoint with tool/function calling. Default: Google Gemini (free tier),
# key from Google AI Studio. Only generativelanguage.googleapis.com and api.openai.com receive LLM_API_KEY; any other
# host must also be set, exactly, in LLM_TRUSTED_BASE_URL. See docs/ENV.md for limits and the free-tier data note.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# LLM_TRUSTED_BASE_URL=
# Spacing between LLM calls in ms (default 6500 on Gemini, for the free tier's per-minute limit; 0 elsewhere).
# LLM_MIN_INTERVAL_MS=

# Set to 1 to force mock fixtures even when keys are present (offline demos/tests).
ROUTED_FORCE_MOCK=
